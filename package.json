{
  "name": "mcpa-bot",
  "version": "1.0.0",
  "description": "**Your personal study buddy for the Model Context Protocol Associate certification!**",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:data": "node --test test/data-integrity.test.js",
    "test:api": "node --test test/api.test.js",
    "test:mcp": "node --test test/mcp-server.test.js",
    "test:e2e": "npx playwright test",
    "test:e2e:training": "npx playwright test e2e/training.spec.js",
    "test:e2e:exam": "npx playwright test e2e/exam.spec.js",
    "test:e2e:ui": "npx playwright test --ui",
    "test:all": "node --test test/*.test.js && npx playwright test",
    "start": "node src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altlv/mcpa-training-bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/altlv/mcpa-training-bot/issues"
  },
  "homepage": "https://github.com/altlv/mcpa-training-bot#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "js-yaml": "^5.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
