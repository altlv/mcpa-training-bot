# =============================================================================
# MCPA Training Bot — Model Configuration
# =============================================================================
# Copy this to .env and fill in the keys you have.
# .env is gitignored — never commit real keys.
#
# The training bot's teaching assistant can use AI models for richer explanations.
# Set at least one provider key below. If none are set, the bot falls back to
# BM25 search + template responses (no AI dependency).
#
# Every provider below speaks the OpenAI chat protocol, so all of them work
# through the one `openai` npm package.

# ---------------------------------------------------------------------------
# API Keys (at least one recommended)
# ---------------------------------------------------------------------------

# Optional — OpenAI (default provider if set)
OPENAI_API_KEY=your_openai_api_key_here

# Optional — OpenRouter (best value: one key fronts hundreds of models, free tier)
OPENROUTER_API_KEY=

# Optional — Groq (fastest inference, free tier)
GROQ_API_KEY=

# Optional — xAI Grok
XAI_API_KEY=

# ---------------------------------------------------------------------------
# Active Provider & Model
# ---------------------------------------------------------------------------

# Which provider powers the teaching assistant.
# Options: openai (default), openrouter, groq, xai, ollama
# If the chosen provider's key is missing, falls back to one that is set.
# CHAT_PROVIDER=openai

# Global model override (applies to whichever provider is active).
# Uncomment to override the per-provider defaults below.
# CHAT_MODEL=

# ---------------------------------------------------------------------------
# Per-Provider Model Overrides
# ---------------------------------------------------------------------------

# Defaults:
#   openai     -> gpt-4o-mini
#   openrouter -> meta-llama/llama-3.3-70b-instruct
#   groq       -> llama-3.3-70b-versatile
#   xai        -> grok-3-mini
#   ollama     -> llama3.2
#
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# GROQ_MODEL=llama-3.3-70b-versatile
# XAI_MODEL=grok-3-mini
# OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Local Models (no key, no cost, works offline)
# ---------------------------------------------------------------------------

# Ollama (runs locally):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# LM Studio (alternative local server):
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=qwen2.5-coder-14b-instruct

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# PORT=3000
